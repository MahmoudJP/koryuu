# Copy this file to `.env.local` and fill in the values below.
# .env.local is gitignored — never commit it.
#
# These two variables let Claude (and you) deploy to Cloudflare Pages
# from this folder without having to log in interactively each time.

# Your Cloudflare account ID. Found in the dashboard URL / right sidebar.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# An API token with permissions to deploy Cloudflare Pages.
# See CLOUDFLARE.md for step-by-step instructions on creating one.
CLOUDFLARE_API_TOKEN=
